# =============================================
# 버즈48 (Buzz48) 환경변수 설정 예시
# 이 파일을 복사하여 .env 로 저장하고 실제 값을 채우세요.
# ⚠️  .env 파일은 절대 Git에 커밋하지 마세요!
# =============================================

# ----- 서버 설정 -----
APP_ENV=development        # development | production
API_PORT=8080
WS_PORT=8081
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,https://buzz48.pl3.kr

# ----- Redis (Oracle Cloud) -----
REDIS_HOST=140.245.64.172
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
# REDIS_TLS=false          # Oracle Cloud 내부 통신이면 false, 외부 TLS 필요 시 true

# ----- PostgreSQL (Neon) -----
# 직접 연결 (마이그레이션, 배치 워커용)
DB_HOST=ep-young-breeze-aoz29ou7.c-2.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your_neon_password_here
DB_SSL_MODE=require        # Neon은 SSL 필수

# 풀러 연결 (API 서버 런타임 — 연결 풀링 성능 최적화)
DB_POOLER_HOST=ep-young-breeze-aoz29ou7-pooler.c-2.ap-southeast-1.aws.neon.tech
DB_POOLER_PORT=5432

# 전체 DSN (pgx 사용 시)
# DATABASE_URL=postgres://neondb_owner:password@ep-young-breeze-aoz29ou7-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ----- JWT / 세션 -----
JWT_SECRET=your_jwt_secret_key_here_minimum_32_chars
SESSION_EXPIRE_HOURS=720   # 30일

# ----- 소셜 로그인 (Phase 2) -----
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ----- FCM 푸시 알림 (Phase 2) -----
FCM_SERVER_KEY=

# ----- AWS (Phase 2~) -----
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=buzz48-uploads
CLOUDFRONT_DOMAIN=

# ----- 결제 PG (Phase 3) -----
KAKAOPAY_SECRET_KEY=
TOSS_SECRET_KEY=

# ----- Next.js 프론트엔드 -----
# NEXT_PUBLIC_* 변수는 브라우저에 노출됨 — 비밀값 절대 사용 금지
NEXT_PUBLIC_API_URL=http://localhost:8082/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8081/ws
