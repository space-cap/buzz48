# ----- 환경변수 (절대 커밋 금지!) -----
.env
.env.local
.env.*.local

# ----- Next.js -----
frontend/.next/
frontend/out/
frontend/node_modules/
frontend/.vercel

# ----- Go -----
backend/bin/
backend/*.exe
backend/*.test

# ----- OS -----
.DS_Store
Thumbs.db
desktop.ini

# ----- IDE -----
.vscode/
.idea/
*.swp
*.swo

# ----- 로그 -----
*.log
logs/
